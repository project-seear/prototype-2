<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>                 <string>Prototype2</string>
    <key>CFBundleDisplayName</key>          <string>Head-Tracked Localization</string>
    <key>CFBundleExecutable</key>           <string>Prototype2</string>
    <key>CFBundleIdentifier</key>           <string>com.seear.prototype2</string>
    <key>CFBundlePackageType</key>          <string>APPL</string>
    <key>CFBundleShortVersionString</key>   <string>1.0</string>
    <key>CFBundleVersion</key>              <string>1</string>
    <key>LSMinimumSystemVersion</key>       <string>14.0</string>
    <key>NSPrincipalClass</key>             <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>      <true/>
    <!-- Required: without this key CoreMotion silently refuses to start
         headphone device-motion updates. -->
    <key>NSMotionUsageDescription</key>
    <string>Prototype 2 reads AirPods head orientation so a virtual sound source can stay fixed in space while you turn your head.</string>
</dict>
</plist>
